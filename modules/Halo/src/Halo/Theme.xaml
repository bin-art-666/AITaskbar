<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="GridViewItemSelectedInnerBorderBrush" Color="Transparent" />
            <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>
            <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>

            <SolidColorBrush x:Key="HaloCardBrush" Color="#17808080" />
            <SolidColorBrush x:Key="HaloCardBorderBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="HaloActionBorderBrush" Color="#BEFFFFFF" />
            <SolidColorBrush x:Key="HaloActionBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#20000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#28000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#38000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="GridViewItemSelectedInnerBorderBrush" Color="Transparent" />
            <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>
            <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>

            <SolidColorBrush x:Key="HaloCardBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="HaloCardBorderBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="HaloActionBorderBrush" Color="#58FFFFFF" />
            <SolidColorBrush x:Key="HaloActionBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#48FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="GridViewItemBackgroundSelected" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPointerOver" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GridViewItemBackgroundSelectedPressed" Color="{ThemeResource SystemColorHighlightColor}" />
            <SolidColorBrush x:Key="GridViewItemSelectedBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="GridViewItemSelectedPointerOverBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="GridViewItemSelectedPressedBorderBrush" Color="{ThemeResource SystemColorHighlightTextColor}" />
            <SolidColorBrush x:Key="GridViewItemSelectedInnerBorderBrush" Color="Transparent" />
            <Thickness x:Key="GridViewItemSelectedBorderThickness">0</Thickness>
            <CornerRadius x:Key="GridViewItemCornerRadius">8</CornerRadius>

            <SolidColorBrush x:Key="HaloCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="HaloCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="HaloActionBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="HaloActionBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Station selection uses native GridView templates, including keyboard focus and contrast states. -->
    <!-- Halo visual language 1.0. All measurements are effective pixels. -->
    <Thickness x:Key="HaloPanelPadding">20,16,20,16</Thickness>
    <Thickness x:Key="HaloCardPadding">12</Thickness>
    <Thickness x:Key="HaloStationCardPadding">12,7,12,7</Thickness>
    <CornerRadius x:Key="HaloPanelRadius">16</CornerRadius>
    <CornerRadius x:Key="HaloCardRadius">12</CornerRadius>
    <CornerRadius x:Key="HaloControlRadius">8</CornerRadius>
    <x:Double x:Key="HaloPanelGap">12</x:Double>
    <x:Double x:Key="HaloActionGap">4</x:Double>
    <x:Double x:Key="HaloTitleSize">23</x:Double>
    <x:Double x:Key="HaloHintSize">12</x:Double>
    <x:Double x:Key="HaloIconSize">20</x:Double>
    <x:Double x:Key="HaloActionSize">36</x:Double>
    <x:Double x:Key="HaloIconStroke">1.5</x:Double>
    <x:Double x:Key="HaloEnterMilliseconds">160</x:Double>
    <x:Double x:Key="HaloEnterOffset">4</x:Double>
    <!-- Panel glass is independent of the user's maximized/top-bar appearance. -->
    <x:Double x:Key="HaloPanelTintOpacity">0.22</x:Double>
    <x:Double x:Key="HaloPanelLuminosityOpacity">0.78</x:Double>



    <!-- Retain the WinUI templates, including focus, disabled and contrast states. -->
    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource HaloControlRadius}" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="{StaticResource HaloControlRadius}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource HaloControlRadius}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource HaloControlRadius}" />
    </Style>
    <Style TargetType="NumberBox">
        <Setter Property="CornerRadius" Value="{StaticResource HaloControlRadius}" />
    </Style>
    <Style TargetType="Expander">
        <Setter Property="CornerRadius" Value="{StaticResource HaloCardRadius}" />
    </Style>
    <Style x:Key="HaloIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource HaloActionSize}" />
        <Setter Property="Height" Value="{StaticResource HaloActionSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HaloControlRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="HaloIconToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource HaloActionSize}" />
        <Setter Property="Height" Value="{StaticResource HaloActionSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource HaloControlRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="HaloCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource HaloCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource HaloCardPadding}" />
        <Setter Property="Background" Value="{ThemeResource HaloCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource HaloCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="HaloItemActionStyle" TargetType="Button" BasedOn="{StaticResource HaloIconButtonStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource HaloActionBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource HaloActionBrush}" />
    </Style>
    <Style x:Key="HaloFramedToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource HaloIconToggleStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource HaloActionBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource HaloActionBrush}" />
    </Style>
</ResourceDictionary>
