<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <SolidColorBrush x:Key="AIEnterCardBrush" Color="#17808080" />
            <SolidColorBrush x:Key="AIEnterCardBorderBrush" Color="#24FFFFFF" />
            <SolidColorBrush x:Key="AIEnterActionBorderBrush" Color="#BEFFFFFF" />
            <SolidColorBrush x:Key="AIEnterActionBrush" Color="#1CFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#14000000" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#20000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#28000000" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#38000000" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Default">
            <SolidColorBrush x:Key="AIEnterCardBrush" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="AIEnterCardBorderBrush" Color="#12FFFFFF" />
            <SolidColorBrush x:Key="AIEnterActionBorderBrush" Color="#58FFFFFF" />
            <SolidColorBrush x:Key="AIEnterActionBrush" Color="#0FFFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#20FFFFFF" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#30FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPointerOver" Color="#38FFFFFF" />
            <SolidColorBrush x:Key="ButtonBorderBrushPressed" Color="#48FFFFFF" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <SolidColorBrush x:Key="AIEnterCardBrush" Color="{ThemeResource SystemColorWindowColor}" />
            <SolidColorBrush x:Key="AIEnterCardBorderBrush" Color="{ThemeResource SystemColorWindowTextColor}" />
            <SolidColorBrush x:Key="AIEnterActionBorderBrush" Color="{ThemeResource SystemColorButtonTextColor}" />
            <SolidColorBrush x:Key="AIEnterActionBrush" Color="{ThemeResource SystemColorButtonFaceColor}" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- AIEnter visual language 1.0. All measurements are effective pixels. -->
    <Thickness x:Key="AIEnterPanelPadding">20,16,20,16</Thickness>
    <Thickness x:Key="AIEnterCardPadding">12</Thickness>
    <Thickness x:Key="AIEnterStationCardPadding">12,7,12,7</Thickness>
    <CornerRadius x:Key="AIEnterPanelRadius">16</CornerRadius>
    <CornerRadius x:Key="AIEnterCardRadius">12</CornerRadius>
    <CornerRadius x:Key="AIEnterControlRadius">8</CornerRadius>
    <x:Double x:Key="AIEnterPanelGap">12</x:Double>
    <x:Double x:Key="AIEnterActionGap">4</x:Double>
    <x:Double x:Key="AIEnterTitleSize">23</x:Double>
    <x:Double x:Key="AIEnterHintSize">12</x:Double>
    <x:Double x:Key="AIEnterIconSize">20</x:Double>
    <x:Double x:Key="AIEnterActionSize">36</x:Double>
    <x:Double x:Key="AIEnterIconStroke">1.5</x:Double>
    <x:Double x:Key="AIEnterEnterMilliseconds">160</x:Double>
    <x:Double x:Key="AIEnterEnterOffset">4</x:Double>
    <!-- Panel glass is independent of the user's maximized/top-bar appearance. -->
    <x:Double x:Key="AIEnterPanelTintOpacity">0.22</x:Double>
    <x:Double x:Key="AIEnterPanelLuminosityOpacity">0.78</x:Double>



    <!-- Retain the WinUI templates, including focus, disabled and contrast states. -->
    <Style TargetType="Button">
        <Setter Property="CornerRadius" Value="{StaticResource AIEnterControlRadius}" />
    </Style>
    <Style TargetType="ToggleButton">
        <Setter Property="CornerRadius" Value="{StaticResource AIEnterControlRadius}" />
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="CornerRadius" Value="{StaticResource AIEnterControlRadius}" />
    </Style>
    <Style TargetType="ComboBox">
        <Setter Property="CornerRadius" Value="{StaticResource AIEnterControlRadius}" />
    </Style>
    <Style TargetType="NumberBox">
        <Setter Property="CornerRadius" Value="{StaticResource AIEnterControlRadius}" />
    </Style>
    <Style TargetType="Expander">
        <Setter Property="CornerRadius" Value="{StaticResource AIEnterCardRadius}" />
    </Style>
    <Style x:Key="AIEnterIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="{StaticResource AIEnterActionSize}" />
        <Setter Property="Height" Value="{StaticResource AIEnterActionSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AIEnterControlRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style x:Key="AIEnterIconToggleStyle" TargetType="ToggleButton">
        <Setter Property="Width" Value="{StaticResource AIEnterActionSize}" />
        <Setter Property="Height" Value="{StaticResource AIEnterActionSize}" />
        <Setter Property="MinWidth" Value="0" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="{StaticResource AIEnterControlRadius}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>
    <Style x:Key="AIEnterCardStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="{StaticResource AIEnterCardRadius}" />
        <Setter Property="Padding" Value="{StaticResource AIEnterCardPadding}" />
        <Setter Property="Background" Value="{ThemeResource AIEnterCardBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AIEnterCardBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="AIEnterItemActionStyle" TargetType="Button" BasedOn="{StaticResource AIEnterIconButtonStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AIEnterActionBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource AIEnterActionBrush}" />
    </Style>
    <Style x:Key="AIEnterFramedToggleStyle" TargetType="ToggleButton" BasedOn="{StaticResource AIEnterIconToggleStyle}">
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource AIEnterActionBorderBrush}" />
        <Setter Property="Background" Value="{ThemeResource AIEnterActionBrush}" />
    </Style>
</ResourceDictionary>
