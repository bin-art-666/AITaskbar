{
  "manifest_version": 3,
  "name": "AITaskbar Chrome 最近关闭",
  "version": "0.1.0",
  "description": "让 AITaskbar 在本地列出并恢复 Chrome 最近关闭的网页标签。",
  "incognito": "not_allowed",
  "permissions": ["sessions", "tabs", "nativeMessaging", "alarms"],
  "key": "",
  "background": { "service_worker": "chrome.js" }
}
